    {
      "key": "dbc5a0f0-e43d-40b3-b8c7-938f787aaad3__step_1",
      "attributes": {
        "id": "dbc5a0f0-e43d-40b3-b8c7-938f787aaad3__step_1",
        "type": "Step",
        "label": "Choose a programming language",
