          "options": [
            "JavaScript (Node.js)",
            "Python",
            "Ruby",
            "Go"
          ]
        }
      }
    },
    {
      "key": "dbc5a0f0-e43d-40b3-b8c7-938f787aaad3__step_2",
      "attributes": {
        "id": "dbc5a0f0-e43d-40b3-b8c7-938f787aaad3__step_2",
        "type": "Step",
        "label": "Identify web framework or library",
        "action": "define_framework",
        "parameters": {
