      "key": "f1ca0669-2898-4e4d-9559-3696c3384d12__intent_node",
      "attributes": {
        "id": "f1ca0669-2898-4e4d-9559-3696c3384d12__intent_node",
        "type": "Intent",
        "label": "How to write a file in python?",
        "vectorId": "43183df9-e6ad-4613-abf8-181f7b2d0e0a"
      }
    },
    {
      "key": "f1ca0669-2898-4e4d-9559-3696c3384d12__step_1",
      "attributes": {
        "id": "f1ca0669-2898-4e4d-9559-3696c3384d12__step_1",
        "type": "Step",
        "label": "Open a file in write mode",
        "action": "code_snippet",
        "parameters": {
          "code": "file = open('filename.txt', 'w')"
        }
      }
    },
    {
      "key": "f1ca0669-2898-4e4d-9559-3696c3384d12__step_2",
      "attributes": {
        "id": "f1ca0669-2898-4e4d-9559-3696c3384d12__step_2",
        "type": "Step",
        "label": "Write content to the file",
        "action": "code_snippet",
        "parameters": {
          "code": "file.write('Hello, World!')"
        }
      }
    },
    {
      "key": "f1ca0669-2898-4e4d-9559-3696c3384d12__step_3",
      "attributes": {
        "id": "f1ca0669-2898-4e4d-9559-3696c3384d12__step_3",
        "type": "Step",
        "label": "Close the file",
        "action": "code_snippet",
        "parameters": {
          "code": "file.close()"
        }
      }
    },
    {
      "key": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__intent_node",
      "attributes": {
        "id": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__intent_node",
        "type": "Intent",
        "label": "How to read a file in python?",
        "vectorId": "20690917-5c29-4602-ba16-3284f046d4fc"
      }
    },
    {
      "key": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_1",
      "attributes": {
        "id": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_1",
        "type": "Step",
        "label": "Open the file in read mode",
        "action": "execute_code",
        "parameters": {
          "code": "file = open('filename.txt', 'r')"
        }
      }
    },
    {
      "key": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_2",
      "attributes": {
        "id": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_2",
        "type": "Step",
        "label": "Read the content of the file",
        "action": "execute_code",
        "parameters": {
          "code": "content = file.read()"
        }
      }
    },
    {
      "key": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_3",
      "attributes": {
        "id": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_3",
        "type": "Step",
        "label": "Print the content",
        "action": "execute_code",
        "parameters": {
          "code": "print(content)"
        }
      }
    },
    {
      "key": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_4",
      "attributes": {
        "id": "4d0788d2-54c3-4b96-894e-6d86f39fd1a3__step_4",
        "type": "Step",
        "label": "Close the file",
        "action": "execute_code",
        "parameters": {
          "code": "file.close()"
        }
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__intent_node",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__intent_node",
        "type": "Intent",
        "label": "Create a simple web server",
        "vectorId": "1101409b-6b53-4562-b55f-d1845c66cf27"
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_1",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_1",
        "type": "Step",
        "label": "Initialize a new Node.js project",
        "action": "execute_shell_command",
        "parameters": {
          "command": "npm init -y"
        }
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_2",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_2",
        "type": "Step",
        "label": "Install the http module",
        "action": "execute_shell_command",
        "parameters": {
          "command": "npm install http"
        }
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_3",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_3",
        "type": "Step",
        "label": "Create a server.js file",
        "action": "execute_shell_command",
        "parameters": {
          "command": "echo \"const http = require('http');\\nconst hostname = '127.0.0.1';\\nconst port = 3000;\\n\\nconst server = http.createServer((req, res) => {\\n  res.statusCode = 200;\\n  res.setHeader('Content-Type', 'text/plain');\\n  res.end('Hello World!\\n');\\n});\\n\\nserver.listen(port, hostname, () => {\\n  console.log(`Server running at http://${hostname}:${port}/`);\\n});\" > server.js"
        }
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_4",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_4",
        "type": "Step",
        "label": "Run the web server",
        "action": "execute_shell_command",
        "parameters": {
          "command": "node server.js"
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__intent_node",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__intent_node",
        "type": "Intent",
        "label": "What is a closure in javascript?",
        "vectorId": "643117c1-324e-4919-99c1-f0251da2d5a3"
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_1",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_1",
        "type": "Step",
        "label": "Define Closure",
        "action": "explain_concept",
        "parameters": {
          "definition": "A closure is a function that has access to its outer function scope even after the outer function has closed."
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_2",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_2",
        "type": "Step",
        "label": "Identify Parts of Closure",
        "action": "list_parts",
        "parameters": {
          "parts": [
            "Inner function",
            "Outer function",
            "Lexical scope"
          ]
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_3",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_3",
        "type": "Step",
        "label": "Provide Example of Closure",
        "action": "give_example",
        "parameters": {
          "example_code": "function outerFunction() { let outerVariable = 'I am outside!'; function innerFunction() { console.log(outerVariable); } return innerFunction; } const closure = outerFunction(); closure(); // Outputs: I am outside!"
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_4",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_4",
        "type": "Step",
        "label": "Explain Use Cases of Closure",
        "action": "explain_use_cases",
        "parameters": {
          "use_cases": [
            "Data privacy and encapsulation",
            "Partial application of functions",
            "Function factories"
          ]
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_5",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_5",
        "type": "Step",
        "label": "Recap Closure Definition",
        "action": "recap",
        "parameters": {
          "recap": "A closure allows access to an outer function's scope from an inner function, even after the outer function has executed."
        }
      }
    },
    {
      "key": "55a701d8-3b1e-4dbf-bc19-0052df607b91__intent_node",
      "attributes": {
        "id": "55a701d8-3b1e-4dbf-bc19-0052df607b91__intent_node",
        "type": "Intent",
        "label": "What is a closure in javascript?",
        "vectorId": "fdb76bed-553c-4225-9813-c755297cc025"
      }
    },
    {
      "key": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_1",
      "attributes": {
        "id": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_1",
        "type": "Step",
        "label": "Define Closure",
        "action": "explain_concept",
        "parameters": {
          "definition": "A closure is a function that retains access to its lexical scope, even when the function is executed outside that scope."
        }
      }
    },
    {
      "key": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_2",
      "attributes": {
        "id": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_2",
        "type": "Step",
        "label": "Provide Example",
        "action": "show_example",
        "parameters": {
          "example": "function outerFunction() { var outerVar = 'I am outside!'; function innerFunction() { console.log(outerVar); } return innerFunction; } var closure = outerFunction(); closure(); // Outputs: I am outside!"
        }
      }
    },
    {
      "key": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_3",
      "attributes": {
        "id": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_3",
        "type": "Step",
        "label": "Discuss Use Cases",
        "action": "list_use_cases",
        "parameters": {
          "use_cases": [
            "Data privacy",
            "Partial application",
            "Maintaining state in async functions"
          ]
        }
      }
    },
    {
      "key": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_4",
      "attributes": {
        "id": "55a701d8-3b1e-4dbf-bc19-0052df607b91__step_4",
        "type": "Step",
        "label": "Summarize Importance",
        "action": "summarize_importance",
        "parameters": {
          "importance": "Closures are essential in JavaScript as they enable powerful programming patterns, like encapsulation and factory functions."
        }
      }
    },
