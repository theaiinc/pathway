      "key": "9056702e-29fc-4771-822b-48c4619b5a06__intent_node",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__intent_node",
        "type": "Intent",
        "label": "Create a simple web server",
        "vectorId": "1101409b-6b53-4562-b55f-d1845c66cf27"
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_1",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_1",
        "type": "Step",
        "label": "Initialize a new Node.js project",
        "action": "execute_shell_command",
        "parameters": {
          "command": "npm init -y"
        }
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_2",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_2",
        "type": "Step",
        "label": "Install the http module",
        "action": "execute_shell_command",
        "parameters": {
          "command": "npm install http"
        }
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_3",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_3",
        "type": "Step",
        "label": "Create a server.js file",
        "action": "execute_shell_command",
        "parameters": {
          "command": "echo \"const http = require('http');\\nconst hostname = '127.0.0.1';\\nconst port = 3000;\\n\\nconst server = http.createServer((req, res) => {\\n  res.statusCode = 200;\\n  res.setHeader('Content-Type', 'text/plain');\\n  res.end('Hello World!\\n');\\n});\\n\\nserver.listen(port, hostname, () => {\\n  console.log(`Server running at http://${hostname}:${port}/`);\\n});\" > server.js"
        }
      }
    },
    {
      "key": "9056702e-29fc-4771-822b-48c4619b5a06__step_4",
      "attributes": {
        "id": "9056702e-29fc-4771-822b-48c4619b5a06__step_4",
        "type": "Step",
        "label": "Run the web server",
        "action": "execute_shell_command",
        "parameters": {
          "command": "node server.js"
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__intent_node",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__intent_node",
        "type": "Intent",
        "label": "What is a closure in javascript?",
        "vectorId": "643117c1-324e-4919-99c1-f0251da2d5a3"
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_1",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_1",
        "type": "Step",
        "label": "Define Closure",
        "action": "explain_concept",
        "parameters": {
          "definition": "A closure is a function that has access to its outer function scope even after the outer function has closed."
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_2",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_2",
        "type": "Step",
        "label": "Identify Parts of Closure",
        "action": "list_parts",
        "parameters": {
          "parts": [
            "Inner function",
            "Outer function",
            "Lexical scope"
          ]
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_3",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_3",
        "type": "Step",
        "label": "Provide Example of Closure",
        "action": "give_example",
        "parameters": {
          "example_code": "function outerFunction() { let outerVariable = 'I am outside!'; function innerFunction() { console.log(outerVariable); } return innerFunction; } const closure = outerFunction(); closure(); // Outputs: I am outside!"
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_4",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_4",
        "type": "Step",
        "label": "Explain Use Cases of Closure",
        "action": "explain_use_cases",
        "parameters": {
          "use_cases": [
            "Data privacy and encapsulation",
            "Partial application of functions",
            "Function factories"
          ]
        }
      }
    },
    {
      "key": "4f07ea98-b237-4109-ac44-5370efafda7f__step_5",
      "attributes": {
        "id": "4f07ea98-b237-4109-ac44-5370efafda7f__step_5",
        "type": "Step",
        "label": "Recap Closure Definition",
        "action": "recap",
        "parameters": {
          "recap": "A closure allows access to an outer function's scope from an inner function, even after the outer function has executed."
        }
      }
    },
