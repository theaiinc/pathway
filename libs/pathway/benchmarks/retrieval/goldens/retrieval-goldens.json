  "similarityEdges": [
    {
      "source": "workflow-oauth-debug_intent",
      "target": "workflow-write-tests_intent"
    }
  ],
  "fixtures": [
    {
      "id": "canonical-read-file",
      "query": "Read a file in Node.js",
      "vectorResults": [
        {
          "vectorId": "vector-read-file",
          "distance": 0.03
        },
        {
          "vectorId": "vector-write-tests",
          "distance": 0.31
        }
      ]
    },
    {
      "id": "paraphrase-oauth",
