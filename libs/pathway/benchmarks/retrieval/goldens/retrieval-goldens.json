{
  "id": "peal-retrieval-v1",
  "version": "1.0.0",
  "workflows": [
    {
      "id": "workflow-read-file",
      "intentNodeId": "workflow-read-file_intent",
      "vectorId": "vector-read-file",
      "intent": "Read a file in Node.js",
      "steps": [
        {
          "id": "workflow-read-file_step_1",
          "label": "Import fs",
          "action": "import_module",
          "parameters": {
            "module": "fs/promises"
          }
        },
        {
          "id": "workflow-read-file_step_2",
          "label": "Read file contents",
          "action": "read_file",
          "parameters": {
            "path": "input.txt"
          }
        }
      ]
    },
    {
      "id": "workflow-oauth-debug",
      "intentNodeId": "workflow-oauth-debug_intent",
      "vectorId": "vector-oauth-debug",
      "intent": "Debug OAuth redirect configuration",
      "steps": [
        {
          "id": "workflow-oauth-debug_step_1",
          "label": "Inspect callback URL",
          "action": "inspect_config",
          "parameters": {
            "field": "redirectUri"
          }
        },
        {
          "id": "workflow-oauth-debug_step_2",
          "label": "Compare provider settings",
          "action": "compare_config",
          "parameters": {
            "provider": "oauth"
          }
        },
        {
          "id": "workflow-oauth-debug_step_3",
          "label": "Validate manifest intent filter",
          "action": "inspect_artifact",
          "parameters": {
            "path": "AndroidManifest.xml"
          }
        }
      ]
    },
    {
      "id": "workflow-write-tests",
      "intentNodeId": "workflow-write-tests_intent",
      "vectorId": "vector-write-tests",
      "intent": "Write unit tests for a TypeScript function",
      "steps": [
        {
          "id": "workflow-write-tests_step_1",
          "label": "Identify behavior",
          "action": "inspect_code",
          "parameters": {
            "target": "function"
          }
        },
        {
          "id": "workflow-write-tests_step_2",
          "label": "Create Vitest cases",
          "action": "write_test",
          "parameters": {
            "runner": "vitest"
          }
        }
      ]
    },
    {
      "id": "workflow-large-perfect",
      "intentNodeId": "workflow-large-perfect_intent",
      "vectorId": "vector-large-perfect",
      "intent": "Generate a long multi-step migration workflow",
      "steps": [
        {
          "id": "workflow-large-perfect_step_1",
          "label": "Step 1",
          "action": "step",
          "parameters": {
            "index": 1
          }
        },
        {
          "id": "workflow-large-perfect_step_2",
          "label": "Step 2",
          "action": "step",
