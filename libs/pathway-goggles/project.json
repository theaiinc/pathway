{
  "name": "pathway-goggles",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/pathway-goggles/src",
  "projectType": "library",
  "license": "UNLICENSED",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/libs/pathway-goggles"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "visualization:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "visualization:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "visualization:build:production",
          "hmr": false
        }
      }
    }
  },
  "tags": []
}
